rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * STAY SAFE AND BRAVE - FIRESTORE SECURITY RULES
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership and collaborator-access model for the 
     * "Stay Safe and Brave" platform. It is designed for the Prototyping Phase, meaning 
     * it prioritizes robust authorization (who can do what) over strict schema validation 
     * (the exact shape of the data).
     * 
     * Data Structure:
     * - /users/{userId}: Private user profiles, accessible only by the owner.
     * - /mentors/{mentorId}: Public mentor profiles, editable only by the mentor owner.
     * - /bookings/{bookingId}: Shared documents accessible by both the Traveler (userId) 
     *   and the Mentor (mentorId) listed within the document.
     * - /users/{userId}/reports/{reportId}: Private travel diaries/reports nested under the owner's path.
     * 
     * Key Security Decisions:
     * 1. Denormalization for Authorization: Critical IDs (userId, mentorId) are required 
     *    inside documents to ensure fast, non-recursive security checks without get() calls.
     * 2. Public Visibility: Only Mentor profiles are public to support the SearchView. 
     *    All other entities require authentication and specific ownership/participation.
     * 3. Relational Integrity: On creation and update, the rules enforce that ownership 
     *    IDs in the data match the authenticated user and remain immutable.
     * 4. State Safety: All updates and deletes require verification that the document 
     *    exists and that the requester is the authorized owner/participant.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks ownership and ensures the document exists for destructive operations. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }


    /** Checks if the authenticated user is the mentor linked via private /mentorAuth/{authUid} mapping. */
    function isLinkedMentor(mentorId) {
      return isSignedIn()
        && mentorId is string
        && exists(/databases/$(database)/documents/mentorAuth/$(request.auth.uid))
        && get(/databases/$(database)/documents/mentorAuth/$(request.auth.uid)).data.mentorId == mentorId;
    }

    /** Checks if the authenticated user has an active admin role in /adminAuth/{authUid}. */
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminAuth/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminAuth/$(request.auth.uid)).data.role == "admin";
    }

    // --- COLLECTION RULES ---

    /**
     * @description Private mapping for admin identities.
     * @path /adminAuth/{authUid}
     * INVARIANT: Document ID is the Firebase Auth UID. Contains { role: "admin" }.
     * @allow (get) Only the authenticated user whose auth.uid matches {authUid} can read their own admin mapping.
     * @deny (list) Listing is forbidden to prevent enumeration.
     * @deny (create, update, delete) Clients cannot write mappings; provisioning is server/admin-tooling only.
     */
    match /adminAuth/{authUid} {
      allow get: if isSignedIn() && request.auth.uid == authUid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Private mapping between Firebase Auth UIDs and public mentor profile IDs.
     * @path /mentorAuth/{authUid}
     * INVARIANT: Document ID is the Firebase Auth UID. Contains { mentorId: string }.
     * @allow (get) Only the authenticated user whose auth.uid matches {authUid} can read their own mapping.
     * @deny (list) Listing is forbidden to prevent enumeration.
     * @deny (create, update, delete) Clients cannot write mappings; provisioning is server/admin-only.
     */
    match /mentorAuth/{authUid} {
      allow get: if isSignedIn() && request.auth.uid == authUid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for User profiles. Access restricted to the owner only.
     * @path /users/{userId}
     * @allow (get) If auth.uid matches {userId}.
     * @deny (list) Global listing of users is forbidden to protect privacy.
     * @principle Restricts access to a user's own data tree and enforces path-to-data consistency.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot be listed for privacy
      
      allow create: if isOwner(userId) 
                    && request.resource.data.id == userId;
      
      allow update: if isExistingOwner(userId) 
                    && request.resource.data.id == resource.data.id;
      
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Mentor profiles are public for discovery but managed by the mentor.
     * @path /mentors/{mentorId}
     * @allow (get, list) Anyone (even unauthenticated) can view mentors for the Search view.
     * @deny (update) If the auth.uid does not match the mentorId.
     * @principle Public Read with Owner-Only Writes.
     */
    match /mentors/{mentorId} {
      allow get, list: if true;
      
      allow create: if isOwner(mentorId) 
                    && request.resource.data.id == mentorId;
      
      allow update: if isExistingOwner(mentorId) 
                    && request.resource.data.id == resource.data.id;
      
      allow delete: if isExistingOwner(mentorId);
    }

    /**
     * @description Bookings created by travelers for local mentors.
     * @path /bookings/{bookingId}
     * @allow (get, list) Travelers may only read their own bookings (where userId == request.auth.uid).
     *                    Admins may read/list all bookings for operational management.
     * @allow (create) Travelers can only create bookings for request.auth.uid with initial status "requested".
     * @allow (update) Admin may update operational status; ownership fields (userId, mentorId, packageId, createdAt) are strictly immutable.
     * @deny (delete) Arbitrary deletes are denied.
     */
    match /bookings/{bookingId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid)
                       || isAdmin();
      
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == "requested";
      
      allow update: if isAdmin()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.mentorId == resource.data.mentorId
                    && request.resource.data.packageId == resource.data.packageId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status',
                      'updatedAt'
                    ])
                    && request.resource.data.status in ['requested', 'confirmed', 'completed', 'cancelled'];
      
      allow delete: if false;
    }

    /**
     * @description Collection group rule for reports to enable public Travel Stories while respecting owner privacy.
     * @path /{path=**}/reports/{reportId}
     */
    match /{path=**}/reports/{reportId} {
      allow read: if ('visibility' in resource.data && resource.data.visibility == 'public')
                  || (isSignedIn() && 'userId' in resource.data && resource.data.userId == request.auth.uid);
    }

    /**
     * @description Travel reports/diaries owned by a specific user.
     * Can be private (default) or explicitly published as public Travel Stories.
     * @path /users/{userId}/reports/{reportId}
     * @allow (get) Owner can read regardless of visibility; public can read only if visibility == 'public'.
     * @allow (list) Owner can list all own reports.
     * @allow (create) Owner can create; userId must match auth.uid and userId in path.
     * @allow (update) Owner can update; userId is immutable.
     * @allow (delete) Owner can delete own report.
     */
    match /users/{userId}/reports/{reportId} {
      allow get: if isOwner(userId)
                 || ('visibility' in resource.data && resource.data.visibility == 'public');
      allow list: if isOwner(userId);
      
      allow create: if isOwner(userId) 
                    && request.resource.data.userId == userId
                    && request.resource.data.userId == request.auth.uid;
      
      allow update: if isExistingOwner(userId) 
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Real mentor reviews tied to a verified booking.
     * @path /reviews/{reviewId}
     * INVARIANT: reviewId === bookingId (deterministic 1:1 review per booking to prevent duplicates).
     * @allow (get, list) Public read so reviews can be displayed on mentor profiles.
     * @allow (create) Authenticated traveler whose uid matches booking.userId and booking.mentorId matches review.mentorId.
     * @allow (update) Traveler owner can edit rating and text; ownership fields (bookingId, mentorId, travelerId, createdAt) are immutable.
     * @deny (delete) Denied.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;

      allow create: if isSignedIn()
                    && request.resource.data.id == reviewId
                    && request.resource.data.bookingId == reviewId
                    && request.resource.data.travelerId == request.auth.uid
                    && exists(/databases/$(database)/documents/bookings/$(reviewId))
                    && get(/databases/$(database)/documents/bookings/$(reviewId)).data.userId == request.auth.uid
                    && request.resource.data.mentorId == get(/databases/$(database)/documents/bookings/$(reviewId)).data.mentorId
                    && (
                      get(/databases/$(database)/documents/bookings/$(reviewId)).data.status in ['confirmed', 'completed']
                    )
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && (
                      !('text' in request.resource.data) || 
                      (request.resource.data.text is string && request.resource.data.text.size() <= 2000)
                    );

      allow update: if isSignedIn()
                    && resource.data.travelerId == request.auth.uid
                    && request.resource.data.travelerId == resource.data.travelerId
                    && request.resource.data.mentorId == resource.data.mentorId
                    && request.resource.data.bookingId == resource.data.bookingId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'rating',
                      'text',
                      'updatedAt'
                    ])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && (
                      !('text' in request.resource.data) || 
                      (request.resource.data.text is string && request.resource.data.text.size() <= 2000)
                    );

      allow delete: if false;
    }

    /**
     * @description Real 1:1 conversations between a traveler and their local mentor, tied to a booking.
     * @path /conversations/{conversationId}
     * INVARIANT: conversationId === bookingId (deterministic 1:1 mapping per booking).
     * @allow (get, list) Authorized traveler or authenticated mentor linked to the conversation's mentorId via authUid.
     * @allow (create) Authenticated traveler whose uid matches travelerId with valid bookingId and mentorId verified from booking.
     * @allow (update) Traveler or linked mentor can update message metadata; ownership fields (travelerId, mentorId, bookingId, createdAt) are immutable.
     * @deny (delete) Denied.
     */
    match /conversations/{conversationId} {
      allow get, list: if isSignedIn() && (
        resource.data.travelerId == request.auth.uid ||
        isLinkedMentor(resource.data.mentorId)
      );

      allow create: if isSignedIn()
                    && request.resource.data.travelerId == request.auth.uid
                    && request.resource.data.bookingId == conversationId
                    && exists(/databases/$(database)/documents/bookings/$(conversationId))
                    && get(/databases/$(database)/documents/bookings/$(conversationId)).data.userId == request.auth.uid
                    && request.resource.data.mentorId == get(/databases/$(database)/documents/bookings/$(conversationId)).data.mentorId;

      allow update: if isSignedIn()
                    && (
                      resource.data.travelerId == request.auth.uid ||
                      isLinkedMentor(resource.data.mentorId)
                    )
                    && request.resource.data.travelerId == resource.data.travelerId
                    && request.resource.data.mentorId == resource.data.mentorId
                    && request.resource.data.bookingId == resource.data.bookingId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'updatedAt',
                      'lastMessageText',
                      'lastMessageSenderId',
                      'lastMessageCreatedAt'
                    ])
                    && request.resource.data.lastMessageSenderId == request.auth.uid
                    && request.resource.data.lastMessageText is string
                    && request.resource.data.lastMessageText.size() > 0
                    && request.resource.data.lastMessageText.size() <= 2000;

      allow delete: if false;

      /**
       * @description Messages within a conversation.
       * @path /conversations/{conversationId}/messages/{messageId}
       * @allow (get, list) Authorized traveler or authenticated linked mentor.
       * @allow (create) Authenticated traveler or linked mentor; senderId must match auth.uid; validates parent conversation using getAfter() for atomic batch support.
       * @deny (update, delete) Messages are immutable once written.
       */
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.travelerId == request.auth.uid ||
          isLinkedMentor(get(/databases/$(database)/documents/conversations/$(conversationId)).data.mentorId)
        );

        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && (
                        getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.travelerId == request.auth.uid ||
                        isLinkedMentor(getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.mentorId)
                      );

        allow update, delete: if false;
      }
    }
  }
}